{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lightsim:schema:run:1",
  "title": "LightSim stored run (runs/<project id>/<run id>.json.gz, gzip-compressed)",
  "description": "Format version 1. Generated from LightSim's data models; the specification is docs/spec/README.md. Licence: a draft waiting for the owner's decision, see docs/spec/README.md.",
  "$defs": {
    "Attachment": {
      "additionalProperties": true,
      "description": "A file kept with the project (STD-02), in its resources folder. The\nhash is the file's when it was attached, so a changed file is noticed.",
      "properties": {
        "path": {
          "pattern": "^resources/[^/\\\\.][^/\\\\]*$",
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "minimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "title": "Attachment",
      "type": "object"
    },
    "Channel": {
      "properties": {
        "elementId": {
          "title": "Elementid",
          "type": "string"
        },
        "portId": {
          "title": "Portid",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "timeSeries": {
          "items": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object"
          },
          "title": "Timeseries",
          "type": "array"
        },
        "min": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "max": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "mean": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        }
      },
      "required": [
        "elementId",
        "portId",
        "label",
        "unit",
        "timeSeries"
      ],
      "title": "Channel",
      "type": "object"
    },
    "Connection": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sourceElementId": {
          "title": "Sourceelementid",
          "type": "string"
        },
        "sourcePortId": {
          "title": "Sourceportid",
          "type": "string"
        },
        "targetElementId": {
          "title": "Targetelementid",
          "type": "string"
        },
        "targetPortId": {
          "title": "Targetportid",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sourceElementId",
        "sourcePortId",
        "targetElementId",
        "targetPortId"
      ],
      "title": "Connection",
      "type": "object"
    },
    "DataBusConnection": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "element1Id": {
          "title": "Element1Id",
          "type": "string"
        },
        "port1Id": {
          "title": "Port1Id",
          "type": "string"
        },
        "element2Id": {
          "title": "Element2Id",
          "type": "string"
        },
        "port2Id": {
          "title": "Port2Id",
          "type": "string"
        }
      },
      "required": [
        "id",
        "element1Id",
        "port1Id",
        "element2Id",
        "port2Id"
      ],
      "title": "DataBusConnection",
      "type": "object"
    },
    "DutyPart": {
      "properties": {
        "elementId": {
          "title": "Elementid",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/DutyRow"
          },
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "elementId",
        "label",
        "kind",
        "rows"
      ],
      "title": "DutyPart",
      "type": "object"
    },
    "DutyRow": {
      "description": "A part's duty for one quantity (RES-39), over the run's solver\nsteps: the highest and lowest value, the time mean and the RMS (the\nroot-mean-square, the mean that sets heating).",
      "properties": {
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "max": {
          "title": "Max",
          "type": "number"
        },
        "min": {
          "title": "Min",
          "type": "number"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "rms": {
          "title": "Rms",
          "type": "number"
        }
      },
      "required": [
        "quantity",
        "unit",
        "max",
        "min",
        "mean",
        "rms"
      ],
      "title": "DutyRow",
      "type": "object"
    },
    "ElementInstance": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "componentDefId": {
          "title": "Componentdefid",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "position": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Position",
          "type": "object"
        },
        "parameterOverrides": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "additionalProperties": {
                  "additionalProperties": {
                    "type": "number"
                  },
                  "type": "object"
                },
                "type": "object"
              },
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              }
            ]
          },
          "title": "Parameteroverrides",
          "type": "object"
        },
        "dynamicPorts": {
          "items": {
            "$ref": "#/$defs/PortDef"
          },
          "title": "Dynamicports",
          "type": "array"
        },
        "portSides": {
          "additionalProperties": {
            "enum": [
              "left",
              "right",
              "top",
              "bottom"
            ],
            "type": "string"
          },
          "title": "Portsides",
          "type": "object"
        },
        "portOffsets": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Portoffsets",
          "type": "object"
        },
        "tableOutside": {
          "additionalProperties": {
            "items": {
              "enum": [
                "error",
                "clamp",
                "linear"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "title": "Tableoutside",
          "type": "object"
        },
        "size": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "number"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size"
        },
        "isSubSystem": {
          "default": false,
          "title": "Issubsystem",
          "type": "boolean"
        },
        "subSystemId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subsystemid"
        }
      },
      "required": [
        "id",
        "componentDefId",
        "label",
        "position"
      ],
      "title": "ElementInstance",
      "type": "object"
    },
    "EnergyFlow": {
      "description": "A band of the energy Sankey chart: a source of the car's energy or\na place it went.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kWh": {
          "title": "Kwh",
          "type": "number"
        },
        "group": {
          "title": "Group",
          "type": "string"
        },
        "elementId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elementid"
        }
      },
      "required": [
        "label",
        "kWh",
        "group"
      ],
      "title": "EnergyFlow",
      "type": "object"
    },
    "EnergyPart": {
      "description": "One row of the energy table (RES-22), kWh: in − out − lost − stored\nis 0 for a part that keeps its books.",
      "properties": {
        "elementId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elementid"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "inKWh": {
          "title": "Inkwh",
          "type": "number"
        },
        "outKWh": {
          "title": "Outkwh",
          "type": "number"
        },
        "lostKWh": {
          "title": "Lostkwh",
          "type": "number"
        },
        "storedKWh": {
          "default": 0.0,
          "title": "Storedkwh",
          "type": "number"
        },
        "lostPct": {
          "default": 0.0,
          "title": "Lostpct",
          "type": "number"
        }
      },
      "required": [
        "label",
        "kind",
        "inKWh",
        "outKWh",
        "lostKWh"
      ],
      "title": "EnergyPart",
      "type": "object"
    },
    "EnergyReport": {
      "properties": {
        "parts": {
          "items": {
            "$ref": "#/$defs/EnergyPart"
          },
          "title": "Parts",
          "type": "array"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EnergyFlow"
          },
          "title": "Sources",
          "type": "array"
        },
        "sinks": {
          "items": {
            "$ref": "#/$defs/EnergyFlow"
          },
          "title": "Sinks",
          "type": "array"
        },
        "sourceKWh": {
          "default": 0.0,
          "title": "Sourcekwh",
          "type": "number"
        },
        "remainderKWh": {
          "default": 0.0,
          "title": "Remainderkwh",
          "type": "number"
        },
        "remainderPct": {
          "default": 0.0,
          "title": "Remainderpct",
          "type": "number"
        },
        "balanceErrorPct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Balanceerrorpct"
        }
      },
      "title": "EnergyReport",
      "type": "object"
    },
    "ExampleCard": {
      "additionalProperties": true,
      "description": "What an example answers and what to expect from it (CON-15): shown in\nthe Project tab and the Open menu; its expected results are the cases'\nreference values (SimCase.references).",
      "properties": {
        "question": {
          "default": "",
          "title": "Question",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "difficulty": {
          "default": "beginner",
          "enum": [
            "beginner",
            "intermediate",
            "advanced"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "runTimeS": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtimes"
        },
        "learn": {
          "items": {
            "type": "string"
          },
          "title": "Learn",
          "type": "array"
        },
        "status": {
          "default": "demo",
          "enum": [
            "demo",
            "plausibility-checked",
            "validated"
          ],
          "title": "Status",
          "type": "string"
        },
        "features": {
          "items": {
            "type": "string"
          },
          "title": "Features",
          "type": "array"
        },
        "author": {
          "default": "",
          "title": "Author",
          "type": "string"
        },
        "version": {
          "default": "",
          "title": "Version",
          "type": "string"
        },
        "licence": {
          "default": "",
          "title": "Licence",
          "type": "string"
        },
        "narrative": {
          "items": {
            "type": "string"
          },
          "title": "Narrative",
          "type": "array"
        }
      },
      "title": "ExampleCard",
      "type": "object"
    },
    "LimitLane": {
      "description": "What held one driveline back (RES-38): the state from each change\non, [t in s, index into LimitReport.states], and the seconds in each.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "elementIds": {
          "items": {
            "type": "string"
          },
          "title": "Elementids",
          "type": "array"
        },
        "changes": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Changes",
          "type": "array"
        },
        "seconds": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Seconds",
          "type": "object"
        }
      },
      "required": [
        "label",
        "elementIds",
        "changes",
        "seconds"
      ],
      "title": "LimitLane",
      "type": "object"
    },
    "LimitReport": {
      "properties": {
        "states": {
          "items": {
            "type": "string"
          },
          "title": "States",
          "type": "array"
        },
        "lanes": {
          "items": {
            "$ref": "#/$defs/LimitLane"
          },
          "title": "Lanes",
          "type": "array"
        },
        "tEnd": {
          "title": "Tend",
          "type": "number"
        }
      },
      "required": [
        "states",
        "lanes",
        "tEnd"
      ],
      "title": "LimitReport",
      "type": "object"
    },
    "LiveEdit": {
      "additionalProperties": true,
      "description": "A scalar parameter change sent to the engine while a run was going.",
      "properties": {
        "t": {
          "title": "T",
          "type": "number"
        },
        "elementId": {
          "title": "Elementid",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "t",
        "elementId",
        "key",
        "value"
      ],
      "title": "LiveEdit",
      "type": "object"
    },
    "PartEnergyFlow": {
      "description": "One part's energy over a run (MOD-10), in kWh, with the duty values\nof its throughput power in kW. For every part energyIn − energyOut −\nlosses − stored = 0; energyIn and energyOut are both ≥ 0 (what entered\nand what left it at any port), and energyInReverse is the part of\nenergyIn that came back from the road side (regeneration, a dragged\nengine).",
      "properties": {
        "elementId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elementid"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "part": {
          "title": "Part",
          "type": "string"
        },
        "energyIn": {
          "title": "Energyin",
          "type": "number"
        },
        "energyOut": {
          "title": "Energyout",
          "type": "number"
        },
        "losses": {
          "title": "Losses",
          "type": "number"
        },
        "stored": {
          "title": "Stored",
          "type": "number"
        },
        "energyInReverse": {
          "default": 0.0,
          "title": "Energyinreverse",
          "type": "number"
        },
        "peakPower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peakpower"
        },
        "meanPower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Meanpower"
        },
        "rmsPower": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmspower"
        },
        "terms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Terms",
          "type": "object"
        }
      },
      "required": [
        "label",
        "part",
        "energyIn",
        "energyOut",
        "losses",
        "stored"
      ],
      "title": "PartEnergyFlow",
      "type": "object"
    },
    "PortDef": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "direction": {
          "enum": [
            "input",
            "output",
            "bidirectional"
          ],
          "title": "Direction",
          "type": "string"
        },
        "kind": {
          "enum": [
            "power",
            "signal",
            "mechanical",
            "electrical",
            "thermal",
            "fluid"
          ],
          "title": "Kind",
          "type": "string"
        },
        "unitGroup": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unitgroup"
        },
        "side": {
          "anyOf": [
            {
              "enum": [
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Side"
        },
        "polarity": {
          "anyOf": [
            {
              "enum": [
                "positive",
                "negative"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Polarity"
        }
      },
      "required": [
        "id",
        "name",
        "direction",
        "kind"
      ],
      "title": "PortDef",
      "type": "object"
    },
    "Project": {
      "additionalProperties": true,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "schemaVersion": {
          "default": 2,
          "title": "Schemaversion",
          "type": "integer"
        },
        "savedWith": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Savedwith"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "systems": {
          "items": {
            "$ref": "#/$defs/SystemNode"
          },
          "title": "Systems",
          "type": "array"
        },
        "dataBusConnections": {
          "items": {
            "$ref": "#/$defs/DataBusConnection"
          },
          "title": "Databusconnections",
          "type": "array"
        },
        "cases": {
          "items": {
            "$ref": "#/$defs/SimCase"
          },
          "title": "Cases",
          "type": "array"
        },
        "card": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExampleCard"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "attachments": {
          "items": {
            "$ref": "#/$defs/Attachment"
          },
          "title": "Attachments",
          "type": "array"
        },
        "cycles": {
          "items": {
            "$ref": "#/$defs/ProjectCycle"
          },
          "title": "Cycles",
          "type": "array"
        },
        "noAi": {
          "default": false,
          "description": "true hides the project from AI tools (the MCP server, an in-app assistant), whatever folders they may see.",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "systems"
      ],
      "title": "Project",
      "type": "object"
    },
    "ProjectCycle": {
      "additionalProperties": true,
      "description": "A drive cycle of the user's own, kept in the project file (CON-11):\na speed (km/h), and optionally a road grade (%), at each point of\n``x``: the time in s, or with ``axis`` \"distance\" the distance driven\nin m (a speed or a grade, or both, against distance). A Driving Task or\nRoad Profile names it by ``id`` in its ``cycle`` parameter, as it names\na bundled one (app/cycles.py checks the fields together).",
      "properties": {
        "id": {
          "pattern": "^own:[A-Za-z0-9._-]{1,64}$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "axis": {
          "default": "time",
          "enum": [
            "time",
            "distance"
          ],
          "title": "Axis",
          "type": "string"
        },
