<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened-runtime exceptions for the macOS build (PLT-13), and no more:
  allow-jit for Electron's JavaScript engine, allow-unsigned-executable-memory
  for the frozen Python engine (ctypes, used by the Script sandbox). No app
  sandbox, camera, microphone, network-client or file entitlements: LightSim
  needs none of them.
  entitlements.mac.plist is the app's own; entitlements.mac.inherit.plist
  applies to every other file signed inside it (Electron's helpers and the
  engine's executable and libraries).
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
