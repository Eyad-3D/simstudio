{
  "name": "lightsim-frontend",
  "private": true,
  "license": "UNLICENSED",
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-data.mjs && node scripts/build-docs.mjs",
    "dev": "vite",
    "prebuild": "node scripts/sync-data.mjs && node scripts/build-docs.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:visual:update": "playwright test visual --update-snapshots"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "dockview": "^8.3.1",
    "dockview-react": "^8.3.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uplot": "1.6.32",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.1",
    "marked": "18.0.14",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@axe-core/playwright": {
      "playwright-core": "$@playwright/test"
    }
  }
}
