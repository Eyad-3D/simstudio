{
  "id": "bev-one-motor",
  "name": "Electric car, one motor",
  "version": 1,
  "example": "bev-car",
  "description": "A battery-electric car with one motor driving one axle through a single reduction gear, pre-wired with its Driver, a WLTC case and the Battery Electric Car's values (2021 Cupra Born class) as the starting point.",
  "slots": {
    "Battery": "el-battery",
    "E-Drive 1": "el-motor",
    "Driveline": "el-final-drive",
    "Chassis": "el-vehicle",
    "Driver": "el-driver",
    "Accessories": "el-consumer"
  },
  "form": [
    {
      "elementId": "el-vehicle",
      "key": "mass_kg",
      "label": "Test mass",
      "unit": "kg",
      "default": 1927,
      "help": "The car's mass with driver and test load.",
      "minimum": 300,
      "maximum": 5000
    },
    {
      "elementId": "el-vehicle",
      "key": "cd",
      "label": "Drag coefficient",
      "unit": "-",
      "default": 0.27,
      "help": "From the maker's data or a wind tunnel.",
      "minimum": 0.15,
      "maximum": 1.0
    },
    {
      "elementId": "el-vehicle",
      "key": "frontal_area_m2",
      "label": "Frontal area",
      "unit": "m²",
      "default": 2.31,
      "help": "",
      "minimum": 1.0,
      "maximum": 10.0
    },
    {
      "elementId": "el-battery",
      "key": "capacity_kWh",
      "label": "Battery usable capacity",
      "unit": "kWh",
      "default": 62,
      "help": "",
      "minimum": 1,
      "maximum": 300
    },
    {
      "elementId": "el-final-drive",
      "key": "ratio",
      "label": "Reduction gear ratio",
      "unit": "-",
      "default": 12.8,
      "help": "Motor turns per wheel turn.",
      "minimum": 1,
      "maximum": 30
    },
    {
      "elementId": "el-consumer",
      "key": "power_kW",
      "label": "Auxiliary load",
      "unit": "kW",
      "default": 0.25,
      "help": "Low-voltage loads; 1-3 kW with heating or air-conditioning.",
      "minimum": 0,
      "maximum": 20
    }
  ]
}
