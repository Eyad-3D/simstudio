        {
          "id": "el-hcu",
          "componentDefId": "signal.script",
          "label": "Hybrid Control Unit",
          "position": {
            "x": 330,
            "y": 40
          },
          "parameterOverrides": {
            "code": "# P2 hybrid supervisory control: charge-sustaining around 55 % SOC.\n# Edit freely; changes apply on the next run. The E-Motor and Engine\n# figures below must match those parts' full-load curves.\nSOC_TARGET = 55.0          # %, the charge the strategy holds\nMIN_ON, MIN_OFF = 8.0, 4.0  # s, minimum engine on and off times\nUP = (18.0, 30.0, 45.0, 58.0, 70.0)  # km/h, upshifts 1-2 ... 5-6\nDOWN_GAP = 6.0             # km/h, downshift this much below the upshift\nMOTOR_T, MOTOR_P = 170.0, 32000.0  # E-Motor: N·m, W\nENGINE_FULL = {800: 105, 1000: 112, 1500: 124, 2000: 132, 2500: 137, 3000: 141,\n               3500: 145, 4000: 147, 4500: 146, 5000: 142, 5500: 134, 5700: 129,\n               6000: 118}  # Engine full-load torque, N·m by 1/min\n\n\ndef step(t, dt, inputs, state, params):\n    soc = inputs.get('soc', SOC_TARGET)\n    v = inputs.get('speed', 0.0)            # km/h\n    trac = inputs.get('traction', 0.0)      # Driver: > 0 pedal, < 0 recuperation\n    n_in = inputs.get('motor_rpm', 0.0)     # gearbox input shaft (= E-Motor)\n    n_eng = inputs.get('engine_rpm', 0.0)\n    if not state:\n        state.update(on=0.0, t_sw=-MIN_OFF, gear=1.0, clutch=0.0)\n\n    # shift map on vehicle speed, with hysteresis\n    gear = state['gear']\n    if gear < 6 and v > UP[int(gear) - 1]:\n        gear += 1.0\n    elif gear > 1 and v < UP[int(gear) - 2] - DOWN_GAP:\n        gear -= 1.0\n    state['gear'] = gear\n\n    # the pedal asks for a share of what motor and engine together can give\n    w = max(n_in, 1.0) * math.pi / 30.0\n    t_mot = min(MOTOR_T, MOTOR_P / w)\n    t_dem = trac * (t_mot + interp(ENGINE_FULL, max(n_in, 1000.0))) if trac > 0 else 0.0\n    p_dem = t_dem * w\n\n    # engine on/off: on above a power threshold that falls as the battery\n    # empties, off at standstill, when coasting and at low demand\n    on = state['on']\n    since = t - state['t_sw']\n    p_on = clamp(10000.0 + 1500.0 * (soc - SOC_TARGET), 3000.0, 20000.0)\n    if on:\n        if v < 1.0 or n_in < 1000.0 or (\n                since >= MIN_ON and (trac <= 0.0 or p_dem < p_on - 6000.0)):\n            on = 0.0\n    elif n_in >= 1100.0 and trac > 0.0 and (\n            t_dem > 0.9 * t_mot or (since >= MIN_OFF and (p_dem > p_on or soc < SOC_TARGET - 4.0))):\n        on = 1.0\n    if on != state['on']:\n        state.update(on=on, t_sw=t, clutch=0.0)\n\n    if not on:\n        # electric drive and recuperation; the engine is off and declutched\n        cmd = trac if trac < 0.0 else t_dem / t_mot\n        return {'motor_cmd': clamp(cmd, -1.0, 1.0), 'throttle': 0.0,\n                'engine_on': 0.0, 'clutch_cmd': 0.0, 'gear': gear}\n    if not state['clutch']:\n        # engine start: bring it up to the input-shaft speed (never above),\n        # then close the clutch\n        if abs(n_in - n_eng) < 100.0:\n            state['clutch'] = 1.0\n        return {'motor_cmd': clamp(t_dem / t_mot, 0.0, 1.0),\n                'throttle': clamp(0.002 * (n_in - n_eng), 0.0, 1.0),\n                'engine_on': 1.0, 'clutch_cmd': 0.0, 'gear': gear}\n\n    # engine clutched in: load-point shifting. The engine runs at no less\n    # than 60 % of full load while the battery is below 60 % (its efficient\n    # region) and the E-Motor charges with the surplus or adds the rest.\n    t_full = interp(ENGINE_FULL, max(n_eng, 800.0))\n    te = t_dem + clamp(3000.0 * (SOC_TARGET - soc), -8000.0, 20000.0) / w\n    te = max(te, 0.6 * t_full * clamp((60.0 - soc) / 5.0, 0.0, 1.0))\n    if trac <= 0.0:\n        te = 0.0  # within the minimum on-time: fuel cut, E-Motor recuperates\n    te = clamp(te, max(0.0, t_dem - t_mot), min(t_full, t_dem + t_mot))\n    tm = trac * t_mot if trac < 0.0 else t_dem - te\n    return {'motor_cmd': clamp(tm / t_mot, -1.0, 1.0), 'throttle': te / t_full,\n            'engine_on': 1.0, 'clutch_cmd': 1.0, 'gear': gear}\n"
          },
